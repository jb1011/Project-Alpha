# Arc
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# Platform / manager (also Factory owner). v1 may be a local key.
PLATFORM_PRIVATE_KEY=0x
# Addresses (defaults exist in addresses.arc-testnet.json; env overrides win)
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
USDC_ADDRESS=0x3600000000000000000000000000000000000000
FACTORY_ADDRESS=0x
# Roles (guardian only needs an address during onboarding)
GUARDIAN_ADDRESS=0x
# Operator signer — pick ONE:
#  (a) Turnkey enclave key (PRODUCTION, non-custodial): set the TURNKEY_* block below incl. TURNKEY_SIGN_WITH.
#  (b) Local key (testnet/dev fallback): OPERATOR_PRIVATE_KEY. Turnkey wins if both are set.
OPERATOR_PRIVATE_KEY=0x
# Storage
DATA_DIR=./data
# Turnkey operator (production, non-custodial). Set all four to use TurnkeySigner:
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_SIGN_WITH=        # the operator wallet ADDRESS (or private-key id) provisioned in Turnkey
TURNKEY_BASE_URL=https://api.turnkey.com
# Per-agent vault: backend-owned delegated API keypair (P-256). Generate once
# (e.g. @turnkey/crypto generateP256KeyPair). Embedded in every agent sub-org,
# scoped sign-only per-sub-org by policy. PRIVATE key is a secret — keep in .env only.
TURNKEY_DELEGATED_API_PUBLIC_KEY=
TURNKEY_DELEGATED_API_PRIVATE_KEY=
# S5 — platform outflow brake + observability (docs/design/2026-08-01-s5-outflow-observability.md)
# Aggregate platform-wallet outflow ceiling per rolling window: ALL paths (fund_treasury, gas
# seeds, job funding, operator CLI) count toward ONE sum; exceeding it rejects fail-closed.
# Boot invariant: ceiling >= MAX_TREASURY_FUND_USDC. Money decisions log to journald as JSON
# (grep "opslog"); every billable Turnkey signature logs too (grep "turnkey_sig").
# PLATFORM_OUTFLOW_CEILING_USDC=200
# PLATFORM_OUTFLOW_WINDOW_HOURS=24

# Circle DevC (Tier-0 custody path; all-or-nothing with CIRCLE_ENTITY_SECRET).
# ⚠ THE ENTITY SECRET IS UNRECOVERABLE WITHOUT THE RECOVERY FILE: keep the recovery file OFFLINE,
# in >=2 locations, never on the VPS and never in this repo. Separate sandbox/prod API keys;
# IP-allowlist the prod key in the Circle console. Half-configured -> boot refuses.
CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=

# Track C — ERC-8183 jobs
# Job contract address (proxy) on Arc testnet
JOB_CONTRACT_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
# Reputation registry address on Arc testnet
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Job client private key (signs on-chain job interactions); defaults to PLATFORM_PRIVATE_KEY if unset
JOB_CLIENT_PRIVATE_KEY=0x
# Job evaluator private key (signs evaluations); required for live job runs; must differ from the provider
JOB_EVALUATOR_PRIVATE_KEY=0x
# Sweep unpaid balances to treasury (true/false; defaults to false)
JOB_SWEEP_TO_TREASURY=false
# Opt-in gate for live job e2e test
# ARC_JOB_LIVE=1

# ── Wizard API (auth + passkey) ─────────────────────────────────────────────
# WEB_ORIGIN=https://project-alpha-pi.vercel.app
# SIWE_DOMAIN=project-alpha-pi.vercel.app
# PASSKEY_RP_ID=project-alpha-pi.vercel.app
# Local defaults: SIWE_DOMAIN=localhost, PASSKEY_RP_ID=localhost
# Note: the production frontend uses window.location.hostname for WebAuthn rpId.

# ── ENS integration (ETHGlobal Lisbon 2026, build 1) ────────────────────────
# `<publicId>.novicorpus.eth` wildcard CCIP-read names on Sepolia.
# Scripts (registration/deploy) use ENS_OWNER_KEY + SEPOLIA_RPC_URL.
# The backend gateway signs record responses with ENS_GATEWAY_SIGNER_KEY.
# Private key of the funded Sepolia manager wallet (TEST-ONLY key). Registers
# novicorpus.eth, deploys the resolver, and calls setResolver.
ENS_OWNER_KEY=0x
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_PARENT_NAME=novicorpus.eth
# Fresh throwaway EOA that only signs the CCIP gateway's record responses.
# Never holds funds. Its ADDRESS goes in the resolver constructor; its KEY
# stays here for the gateway. Generate with: cast wallet new
ENS_GATEWAY_SIGNER_KEY=0x
# Deployed OffchainResolver address (filled after T2 deploy).
ENS_RESOLVER_ADDRESS=0x
# Vanity subnames: `label=publicId`, comma-separated. Lets a memorable name point at an
# existing agent without rewriting a publicId that is already baked into its on-chain
# metadataURI. e.g. ENS_LABEL_ALIASES=demo=b46fd15c-8fbc-4472-a2c9-2eb2fca24a73
# ENS_LABEL_ALIASES=

# ── World ID: the guardian gate (ETHGlobal Lisbon 2026) ────────────────────
# A Wyoming DAO LLC needs a real natural person behind it, so proof of personhood
# gates entity creation. All THREE portal credentials are required together — with any
# of them missing the whole World surface stays unmounted and the gate is a no-op.
# WORLD_APP_ID=app_...
# WORLD_RP_ID=rp_...
# WORLD_RP_SIGNING_KEY=...
#
# The portal action proofs are issued against. NOTE: World issues ONE proof per human
# per action, so an action is "burned" once a given person verifies with it — demos and
# re-tests need a FRESH action, not a re-run of this one.
# WORLD_ACTION=guardian
#
# false/unset = the gate records verifications but never refuses onboarding.
# true = no legal entity may be created without a verified human (web AND MCP paths).
# WORLD_REQUIRE_GUARDIAN=true
#
# Optional anti-sybil ceiling on entities per human. Unset = unlimited, which is what
# the law actually allows (Wyoming does not cap how many LLCs a person may control).
# WORLD_MAX_ENTITIES_PER_HUMAN=
#
# Identity Check step-up (optional). Absent = the whole attestation surface is unmounted,
# so deploying the feature is a no-op until this is deliberately set. Needs its own action.
# WORLD_ATTEST_ACTION=guardian-attest
# WORLD_ATTEST_MIN_AGE=18
#
# production | staging | sandbox. `sandbox` is World's dedicated test environment (its own
# mobile app + RESETTABLE accounts = unlimited fake humans) — the way to exercise the sybil
# gate and fresh-user flows; see docs/runbooks/world-sandbox-testing.md + .env.sandbox.example.
# `staging` remains what our captured fixtures came from. Never point production at either.
# WORLD_ENVIRONMENT=production

# ── World AgentKit / AgentBook: human-backed agent commerce ─────────────────
# Read-only lookups on World Chain ("does a verified human answer for this agent wallet?").
# Both have working defaults; the RPC default is a SHARED public endpoint, so set your own
# for anything beyond a demo.
# WORLD_CHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
# WORLD_AGENTBOOK_ADDRESS=0xA23aB2712eA7BBa896930544C7d6636a96b944dA
#
# Per-human authorization budget on a paid resource, and the window it resets over.
# WORLD_ALLOWANCE_PER_HUMAN=3
# WORLD_RATE_WINDOW_HOURS=24
#
# Seller trust policy. "open" = AgentKit authorizes within the allowance, everyone else pays.
# "accountable-only" = agents no verified human answers for are refused outright (403), and
# human-backed agents still pay. ⚠ Strict mode is DEMO-ONLY today: World's client SDK only
# recovers from 402 responses, never 403, so conforming agents cannot complete the flow.
# X402_TRUST_POLICY=open
#
# Buyer-side trust dial (the other half): "verified-sellers-only" makes OUR agents refuse to PAY
# any address AgentBook does not vouch a human for (deny reasons: seller-not-human-backed /
# seller-verification-unavailable; an RPC outage denies fail-closed but is never cached). "open"
# (default) = today's behavior. Flip at real-money mainnet per the trust-policy spec.
# X402_BUYER_TRUST_POLICY=open
#
# AgentBook-registered key used by the /proof demo page (signs AgentKit messages, holds no
# funds). Register its ADDRESS first: npx @worldcoin/agentkit-cli register <address>
# X402_PROOF_AGENT_KEY=0x
