# Arc
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# Platform / manager (also Factory owner). v1 may be a local key.
PLATFORM_PRIVATE_KEY=0x
# Addresses (defaults exist in addresses.arc-testnet.json; env overrides win)
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
USDC_ADDRESS=0x3600000000000000000000000000000000000000
FACTORY_ADDRESS=0x
# NoviController (docs/design/2026-08-13-novi-controller-design.md). Set it and the platform
# manager IDENTITY becomes this contract — the immutable `manager` of every new agent's vaults,
# the factory/beacon owner and the holder of each agent's identity NFT — while
# PLATFORM_PRIVATE_KEY above is demoted to the EXECUTOR (tx sender) that relays through it.
# Requires FACTORY_ADDRESS to be set explicitly to the factory the controller OWNS (boot refuses
# otherwise): relaying createEntity to a factory owned by anyone else reverts on the first onboard.
# Unset = legacy behavior (the signing key IS the manager and calls targets directly).
#
# Routing is PER AGENT, not per deployment: `AgentTreasury.manager` is immutable, so agents minted
# BEFORE the cutover keep the old EOA as their manager forever and their calls keep going direct.
# Setting this does not change anything for them.
#
# Boot verifies the following ON CHAIN and refuses to start on a mismatch, naming the check:
#   * FACTORY_ADDRESS.owner() == CONTROLLER_ADDRESS  (also catches a pending acceptOwnership)
#   * all 7 executor selector grants held by PLATFORM_PRIVATE_KEY's address
#   * the 2 M5 registry pins (setAgentWallet/setMetadata) pointing at IDENTITY_REGISTRY
# Without a controller, boot instead requires FACTORY_ADDRESS.owner() == the signing key — which is
# what catches "flipped the factory, forgot CONTROLLER_ADDRESS".
#
# Also required in controller mode when the ENS gateway is on: ENS_APEX_RESOLVES_TO (see below).
# CONTROLLER_ADDRESS=0x
# Roles (guardian only needs an address during onboarding)
GUARDIAN_ADDRESS=0x
# Operator signer — pick ONE:
#  (a) Turnkey enclave key (PRODUCTION, non-custodial): set the TURNKEY_* block below incl. TURNKEY_SIGN_WITH.
#  (b) Local key (testnet/dev fallback): OPERATOR_PRIVATE_KEY. Turnkey wins if both are set.
OPERATOR_PRIVATE_KEY=0x
# Storage
DATA_DIR=./data
# Turnkey operator (production, non-custodial). Set all four to use TurnkeySigner:
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_SIGN_WITH=        # the operator wallet ADDRESS (or private-key id) provisioned in Turnkey
TURNKEY_BASE_URL=https://api.turnkey.com
# Per-agent vault: backend-owned delegated API keypair (P-256). Generate once
# (e.g. @turnkey/crypto generateP256KeyPair). Embedded in every agent sub-org,
# scoped sign-only per-sub-org by policy. PRIVATE key is a secret — keep in .env only.
TURNKEY_DELEGATED_API_PUBLIC_KEY=
TURNKEY_DELEGATED_API_PRIVATE_KEY=
# S5 — platform outflow brake + observability (docs/design/2026-08-01-s5-outflow-observability.md)
# Aggregate platform-wallet outflow ceiling per rolling window: ALL paths (fund_treasury, gas
# seeds, job funding, operator CLI) count toward ONE sum; exceeding it rejects fail-closed.
# Boot invariant: ceiling >= MAX_TREASURY_FUND_USDC. Money decisions log to journald as JSON
# (grep "opslog"); every billable Turnkey signature logs too (grep "turnkey_sig").
# PLATFORM_OUTFLOW_CEILING_USDC=200
# PLATFORM_OUTFLOW_WINDOW_HOURS=24

# Circle DevC (Tier-0 custody path; all-or-nothing with CIRCLE_ENTITY_SECRET).
# ⚠ THE ENTITY SECRET IS UNRECOVERABLE WITHOUT THE RECOVERY FILE: keep the recovery file OFFLINE,
# in >=2 locations, never on the VPS and never in this repo. Separate sandbox/prod API keys;
# IP-allowlist the prod key in the Circle console. Half-configured -> boot refuses.
CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# The platform wallet set id (console/"novi-tier0"); needed to provision circle-path agents.
# CIRCLE_WALLET_SET_ID=

# Track C — ERC-8183 jobs
# Job contract address (proxy) on Arc testnet
JOB_CONTRACT_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
# Reputation registry address on Arc testnet
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Job client private key (signs on-chain job interactions); defaults to PLATFORM_PRIVATE_KEY if unset
JOB_CLIENT_PRIVATE_KEY=0x
# Job evaluator private key (signs evaluations); required for live job runs; must differ from the provider
JOB_EVALUATOR_PRIVATE_KEY=0x
# Sweep unpaid balances to treasury (true/false; defaults to false)
JOB_SWEEP_TO_TREASURY=false
# Opt-in gate for live job e2e test
# ARC_JOB_LIVE=1

# ── Wizard API (auth + passkey) ─────────────────────────────────────────────
# WEB_ORIGIN=https://project-alpha-pi.vercel.app
# SIWE_DOMAIN=project-alpha-pi.vercel.app
# PASSKEY_RP_ID=project-alpha-pi.vercel.app
# Local defaults: SIWE_DOMAIN=localhost, PASSKEY_RP_ID=localhost
# Note: the production frontend uses window.location.hostname for WebAuthn rpId.

# ── ENS integration (ETHGlobal Lisbon 2026, build 1) ────────────────────────
# `<publicId>.novicorpus.eth` wildcard CCIP-read names on Sepolia.
# Scripts (registration/deploy) use ENS_OWNER_KEY + SEPOLIA_RPC_URL.
# The backend gateway signs record responses with ENS_GATEWAY_SIGNER_KEY.
# Private key of the funded Sepolia manager wallet (TEST-ONLY key). Registers
# novicorpus.eth, deploys the resolver, and calls setResolver.
ENS_OWNER_KEY=0x
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_PARENT_NAME=novicorpus.eth
# Fresh throwaway EOA that only signs the CCIP gateway's record responses.
# Never holds funds. Its ADDRESS goes in the resolver constructor; its KEY
# stays here for the gateway. Generate with: cast wallet new
ENS_GATEWAY_SIGNER_KEY=0x
# Deployed OffchainResolver address (filled after T2 deploy).
ENS_RESOLVER_ADDRESS=0x
# Vanity subnames: `label=publicId`, comma-separated. Lets a memorable name point at an
# existing agent without rewriting a publicId that is already baked into its on-chain
# metadataURI. e.g. ENS_LABEL_ALIASES=demo=b46fd15c-8fbc-4472-a2c9-2eb2fca24a73
# ENS_LABEL_ALIASES=
# Address the APEX name (ENS_PARENT_NAME itself, not the agent subnames) resolves to. Explicit by
# design: unset it keeps resolving to the platform signing key, so turning on CONTROLLER_ADDRESS
# never silently repoints the apex at a contract that can be neither paid nor spent from.
# REQUIRED once CONTROLLER_ADDRESS and ENS_GATEWAY_SIGNER_KEY are both set (boot refuses otherwise):
# in controller mode the signing key is a ROTATABLE executor, and an apex left to follow it would
# silently move to whatever key was rotated in. Name a receiving address — NOT the controller,
# which can neither hold funds nor be paid.
# ENS_APEX_RESOLVES_TO=0x

# ── World ID: the guardian gate (ETHGlobal Lisbon 2026) ────────────────────
# A Wyoming DAO LLC needs a real natural person behind it, so proof of personhood
# gates entity creation. All THREE portal credentials are required together — with any
# of them missing the whole World surface stays unmounted and the gate is a no-op.
# WORLD_APP_ID=app_...
# WORLD_RP_ID=rp_...
# WORLD_RP_SIGNING_KEY=...
#
# The portal action proofs are issued against. NOTE: World issues ONE proof per human
# per action, so an action is "burned" once a given person verifies with it — demos and
# re-tests need a FRESH action, not a re-run of this one.
# WORLD_ACTION=guardian
#
# false/unset = the gate records verifications but never refuses onboarding.
# true = no legal entity may be created without a verified human (web AND MCP paths).
# WORLD_REQUIRE_GUARDIAN=true
#
# Optional anti-sybil ceiling on entities per human. Unset = unlimited, which is what
# the law actually allows (Wyoming does not cap how many LLCs a person may control).
# WORLD_MAX_ENTITIES_PER_HUMAN=
#
# The COMPANY twin (2026-08-26 §6.7): a ceiling on FILINGS per verified human, which is a
# different thing from a ceiling on agents — a company is a real Wyoming record with a real fee
# behind it, where an agent is software. REQUIRED for production formation: a box running
# DOOLA_ENVIRONMENT=production refuses to boot without this, without all three WORLD_* credentials
# above, and without WORLD_REQUIRE_GUARDIAN — because `assertGuardianAllowed` silently passes
# everyone when the World block is only half-configured, so anonymous USDC would buy real LLCs.
# WORLD_MAX_COMPANIES_PER_HUMAN=3
#
# Identity Check step-up (optional). Absent = the whole attestation surface is unmounted,
# so deploying the feature is a no-op until this is deliberately set. Needs its own action.
# WORLD_ATTEST_ACTION=guardian-attest
# WORLD_ATTEST_MIN_AGE=18
#
# production | staging | sandbox. `sandbox` is World's dedicated test environment (its own
# mobile app + RESETTABLE accounts = unlimited fake humans) — the way to exercise the sybil
# gate and fresh-user flows; see docs/runbooks/world-sandbox-testing.md + .env.sandbox.example.
# `staging` remains what our captured fixtures came from. Never point production at either.
# WORLD_ENVIRONMENT=production

# ── World AgentKit / AgentBook: human-backed agent commerce ─────────────────
# Read-only lookups and registration writes on World Chain ("does a verified human answer for
# this agent wallet?").
# Both have working defaults; the RPC default is a SHARED public endpoint, so set your own
# for anything beyond a demo.
# WORLD_CHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
# WORLD_AGENTBOOK_ADDRESS=0xA23aB2712eA7BBa896930544C7d6636a96b944dA
#
# AgentBook registration (design 2026-08-25 v3 §4.2). A dedicated key holding World Chain ETH
# only; never reuse another key, never fund this address on any other chain. Absent = the
# "Vouch for this agent" action is unavailable and GET /config says so.
# WORLDCHAIN_SUBMITTER_PRIVATE_KEY=0x...
# The write endpoint; defaults to WORLD_CHAIN_RPC when unset.
# WORLDCHAIN_SUBMITTER_RPC=https://worldchain-mainnet.g.alchemy.com/v2/<key>
#
# Per-human authorization budget on a paid resource, and the window it resets over.
# WORLD_ALLOWANCE_PER_HUMAN=3
# WORLD_RATE_WINDOW_HOURS=24
#
# Seller trust policy. "open" = AgentKit authorizes within the allowance, everyone else pays.
# "accountable-only" = agents no verified human answers for are refused outright (403), and
# human-backed agents still pay. "legal-bodies-only" = accountable-only PLUS a registered Novi
# legal body in good standing behind the payer address: a human-backed agent no legal body stands
# behind is refused 403 legal_body_required, and a legal-body read that FAILS refuses 503 rather
# than guessing. ⚠ Strict mode is DEMO-ONLY today: World's client SDK only recovers from 402
# responses, never 403, so conforming agents cannot complete the flow. The demo wall at
# /x402-demo/legal-bodies-wall pins "legal-bodies-only" itself, so showing the policy needs no
# change here.
# X402_TRUST_POLICY=open
#
# Buyer-side trust dial (the other half): "verified-sellers-only" makes OUR agents refuse to PAY
# any address AgentBook does not vouch a human for (deny reasons: seller-not-human-backed /
# seller-verification-unavailable; an RPC outage denies fail-closed but is never cached). "open"
# (default) = today's behavior. Flip at real-money mainnet per the trust-policy spec.
# X402_BUYER_TRUST_POLICY=open
#
# AgentBook-registered key used by the /proof demo page (signs AgentKit messages, holds no
# funds). Register its ADDRESS first: npx @worldcoin/agentkit-cli register <address>
# X402_PROOF_AGENT_KEY=0x

# ── doola formation provider: REAL legal bodies ────────────────────────────
# back/docs/design/2026-08-19-doola-formation-provider-design.md
# Without this block the deployment forms nothing and every entity keeps the stub
# (ein "STUB-NOT-FILED", formation_provider = null) — the credential-less shape stays supported.
#
# ALL-OR-NOTHING over the API key + the webhook secret; half-configured -> boot refuses.
# The key is sent RAW in the Authorization header (no Bearer prefix — doola's contract).
# dk_test_… against sandbox, dk_live_… against production. Both are SECRETS (redacted in logs).
# DOOLA_API_KEY=dk_test_...
# HMAC-SHA256 key for inbound webhooks. Issued and rotated BY DOOLA OVER EMAIL — the portal holds
# only the URL + subscriptions, so there is no self-serve rotation button.
# DOOLA_WEBHOOK_SECRET=
# Zero-downtime rotation: request the new secret, set the OLD one here, deploy, confirm, drop it.
# Both are verified (timing-safe) while this is set.
# DOOLA_WEBHOOK_SECRET_PREVIOUS=
# sandbox | production. Sandbox is free and DEMO-watermarks every document; it is labeled amber
# on every surface and can never be rendered as a real formation.
# DOOLA_ENVIRONMENT=sandbox
# Optional host override. Default: sandbox -> https://api.test.doola.com,
# production -> https://api.doola.com
# DOOLA_BASE_URL=
#
# Arc network identity. testnet (default) | mainnet. NOT derived from NODE_ENV on purpose — the
# testnet box runs NODE_ENV=production against doola sandbox by design. Setting `mainnet` REFUSES
# to boot: without the doola block; with DOOLA_ENVIRONMENT=sandbox (a mainnet deployment must
# never file DEMO entities); with FORMATION_REQUIRED=false (mainnet entities are never stub-only);
# or while ARC_CHAIN_ID is still the TESTNET chain id above. `testnet` likewise refuses any
# ARC_CHAIN_ID other than the testnet one — the two vars describe ONE network.
# ARC_NETWORK=testnet
#
# Formation is MANDATORY (initiated at onboarding, non-blocking). Unset/blank = TRUE whenever the
# doola block is configured, FALSE otherwise. Setting it true WITHOUT the block refuses to boot in
# production (it would 400 every onboard at the door). Accepted values are true|1|yes /
# false|0|no, case-insensitive — anything else is a config error and refuses to boot.
# FORMATION_REQUIRED=true
# Sweeper cadence (the first recurring timer in the API process).
# FORMATION_SWEEP_MS=60000
# Spend controls — formation is real money in production ($100–150 per filing). The door refuses
# BEFORE an entity is minted, so an entity is never left live with a dead mandatory formation.
# FORMATION_MAX_PER_TENANT=3    # CHARGEABLE companies per tenant (ready, or carrying a live
#                               # payment). Drafts never count: with payment on a company can sit
#                               # in draft for days, and an abandoned form must not exhaust a quota.
# FORMATION_DAILY_CEILING=10    # rolling-24h create_provider rows across the whole deployment —
#                               # where the fee is actually incurred, failed ones included.
#
# How many agents may share ONE company's filing (2026-08-26 §3). Each attached agent is its own
# anchor sequence per late fact — two sponsored on-chain writes through its own timelock, plus a
# guardian notification — so an EIN landing on a ten-agent company is ~60 transactions.
# FORMATION_MAX_AGENTS_PER_COMPANY=10
# Sandbox files a LABELED synthetic identity instead of a real natural person, so real names and
# addresses are never sent to doola's development environment. Unset = TRUE in sandbox.
# FORMATION_SANDBOX_SYNTHETIC_PII=true
#
# ── THE SSN KEY (2026-08-26 §4.2) ────────────────────────────────────────────────────────────
#
# AES-256 key for the responsible party's SSN: 32 bytes, base64 or hex.
#
#     openssl rand -base64 32
#
# REQUIRED when DOOLA_ENVIRONMENT=production — that is the only deployment that collects one, and
# without a key the door could only refuse every such create or store one in the clear. REFUSED
# when DOOLA_ENVIRONMENT=sandbox: a sandbox box refuses the SSN field outright, so a key there is
# at best dead weight and at worst a production key in the wrong .env.
#
# ⚠ IF THIS KEY IS LOST, every SSN written under it is unrecoverable. Companies that already have
# a doola company id lose nothing (their SSN was deleted at that moment); one whose create is
# still in flight parks CRITICAL for a human. Back it up where you back up AUTH_JWT_SECRET.
# Rotation, and what this key does and does NOT defend, are in docs/runbooks/doola-deploy.md.
# FORMATION_PII_KEY=
# The key being RETIRED, during a rotation window only. Stored rows name the key they were written
# with, so this one is SELECTED for the rows that need it rather than trial-decrypted. Setting it
# WITHOUT FORMATION_PII_KEY is refused at boot, and so is setting both to the same key.
# FORMATION_PII_KEY_PREVIOUS=

# --- FORMATION PAYMENTS (2026-08-26 §6; B1) ------------------------------------------------
# Built now, shipped OFF: with FORMATION_PAYMENT_REQUIRED unset a company lands `ready` exactly as
# it does today, no payment row is ever written, and the wizard says formation is included during
# the beta. Nothing below changes anything until the flag is deliberately set.
#
# Turning it ON is gated at BOOT by six invariants, because every failure mode here is silent:
#   0. this box must be able to FILE (DOOLA_API_KEY + DOOLA_WEBHOOK_SECRET): every formation door
#      is closed without them, so the fee would be the only thing that worked;
#   1. FORMATION_REVENUE_ADDRESS must be set — a deployment that charges must say where the money
#      goes;
#   2. DOOLA_ENVIRONMENT must NOT be sandbox — a sandbox filing is a DEMO record, not a legal
#      body, and charging 399 USDC for one is a deception rather than a misconfiguration;
#   3. the revenue address must not equal PLATFORM_PRIVATE_KEY's address or ANY other key this box
#      signs with, nor any agent operator/pocket address in the database (checked at API boot
#      against the fleet);
#   4. FORMATION_SETTLE_SUBMITTER_KEY must be set, and must be none of the above;
#   5. the IDENTITY FLOOR — the WORLD_* block WIRED, WORLD_REQUIRE_GUARDIAN on, and
#      WORLD_MAX_COMPANIES_PER_HUMAN set. Charging is production formation whatever the provider
#      credentials say, and an anonymous wallet must not be able to buy real Wyoming LLCs.
# FORMATION_PAYMENT_REQUIRED=false
#
# The all-in fee in WHOLE USDC. Public pricing: it is served on GET /config and rendered verbatim.
# The Wyoming state fee ($100) is OUTSIDE doola's pack and is shown as a BREAKDOWN LINE in copy —
# never added at checkout — which is why this never needs cents.
# FORMATION_FEE_USDC=399
#
# ⚠ A LEDGER HARDWARE-WALLET ACCOUNT. Receive-only: NO KEY FOR IT EXISTS ON THIS BOX, and that is
# the point (S4 key inventory). Refunds are signed manually from the Ledger by runbook and only
# RECORDED here (`npm run cli -- formation:refund`), so nothing on this box can move this money.
# Required when FORMATION_PAYMENT_REQUIRED is on; refused if it equals any key above.
# FORMATION_REVENUE_ADDRESS=
#
# ⚠ THE DEDICATED SETTLE SUBMITTER — the EOA that puts guardians' authorizations on-chain, and
# does nothing else. NOT the platform key, and the boot refuses it if it is:
#   - NONCE SPACE. The platform key signs registry writes, sweeps and job transactions; sharing a
#     nonce with them lets unrelated traffic starve or replace a settle while a guardian watches;
#   - GAS. On Arc the gas token IS USDC, so this address holds a small, single-purpose, visible
#     float. Keep it topped up: a dry submitter does not refuse loudly, it leaves payments
#     `settling` with authorizations already signed. The boot line prints the address and warns
#     below ~1 USDC.
#   - AUTHORITY. It needs none, and has none: not the factory owner, not the controller, not a
#     treasury signer. A compromise of it wastes gas and nothing else.
# Required when FORMATION_PAYMENT_REQUIRED is on.
# FORMATION_SETTLE_SUBMITTER_KEY=
#
# How long a quote stands before the sweeper expires it. Long enough to read the page and open a
# wallet; short enough that a forgotten tab is not a live authorization someone could still use.
# FORMATION_QUOTE_TTL_MS=1800000
#
# ⚠ THE SETTLEMENT GRACE — how much longer than the QUOTE the guardian's AUTHORIZATION stays
# valid. They are two different promises: the TTL is what a person is shown ("this price stands
# for 30 minutes"), and `validBefore` is what the TOKEN enforces, which has to survive the
# signature arriving, the transaction being composed, broadcast and mined, and (after a crash) the
# sweeper re-composing it. With one deadline for both, a signature given at minute 29 expires
# while its own transfer is in the mempool and the guardian is told to pay again.
# A settle request past the TTL is refused with a re-quote even though the token would still take
# it, and expiry is judged on the CHAIN's clock (block timestamp, plus a 120-second margin).
# FORMATION_SETTLE_GRACE_MS=900000
