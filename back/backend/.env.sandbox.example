# ── World SANDBOX testing profile ────────────────────────────────────────────
#
# Copy to `.env.sandbox`, fill the real values, then run:  npm run api:sandbox
# (dotenv/config honors DOTENV_CONFIG_PATH, which that script sets.)
#
# WHAT THIS IS FOR: testing the guardian/onboarding flow with FAKE humans. World's
# Sandbox is a production-like environment with its own mobile app (TestFlight /
# Play tester build) and RESETTABLE accounts — delete and re-create identities at
# will, so the one-human-one-tenant sybil gate can be exercised with as many
# distinct "humans" as a test needs. See docs/runbooks/world-sandbox-testing.md.
#
# WHAT IT CANNOT DO: real uniqueness, load testing, production sign-off, and there
# is NO sandbox AgentBook (the on-chain register is mainnet-only) — seller-side
# human-backing stays covered by the injected readers in the test suite.
#
# NEVER point this profile at the production database or production World action.

# Isolated data dir so sandbox runs never touch a real DB.
DATA_DIR=./data-sandbox

# ── Boot requirements (api/main.ts refuses to start without these) ───────────
# Chain config can stay testnet — sandbox only changes the World side. For pure
# World-gate testing any reachable RPC works; for a full onboarding saga copy the
# keyed RPC URL from the prod .env (it embeds an API key, so it is not baked here).
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# The real (public, on-chain) factory + registry on Arc testnet:
FACTORY_ADDRESS=0x91997dFcDE0046eA4AbE67a5De9E1DF54c9B6902
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# Any throwaway 0x + 64-hex dev key. Boot only derives an address from it; it
# would need testnet funds only if the post-gate onboarding saga actually runs.
# PLATFORM_PRIVATE_KEY=0x...
#
# Turnkey: boot checks PRESENCE only. Dummy strings are fine for World-gate
# testing (the saga stops at vault provisioning — which today is quota-blocked
# anyway); put the real values in only when you want the full E2E post-upgrade.
TURNKEY_API_PUBLIC_KEY=sandbox-dummy
TURNKEY_API_PRIVATE_KEY=sandbox-dummy
TURNKEY_ORGANIZATION_ID=sandbox-dummy
TURNKEY_SIGN_WITH=sandbox-dummy
TURNKEY_DELEGATED_API_PUBLIC_KEY=sandbox-dummy
TURNKEY_DELEGATED_API_PRIVATE_KEY=sandbox-dummy

# ── World: same portal app/rp as dev, but environment=sandbox ────────────────
# Copy these three from your existing back/backend/.env (they are already there).
# WORLD_APP_ID=app_...
# WORLD_RP_ID=rp_...
# WORLD_RP_SIGNING_KEY=...
#
# Use a DEDICATED action for sandbox testing so experiments never collide with
# the production `guardian` action's nullifier space.
WORLD_ACTION=guardian-sandbox
WORLD_REQUIRE_GUARDIAN=true
WORLD_ENVIRONMENT=sandbox

# Optional: the Identity Check step-up, also against sandbox.
# WORLD_ATTEST_ACTION=guardian-attest-sandbox
# WORLD_ATTEST_MIN_AGE=18

# ── doola formation provider (sandbox) ───────────────────────────────────────
# Free, DEMO-watermarked filings against doola's development environment. Our sandbox access
# runs through mid-Sept 2026; the credentials live in Martin's vault, never in this repo.
# Leave the whole block commented out and the sandbox profile forms nothing (stub entities) —
# exactly like today.
# DOOLA_API_KEY=dk_test_...
# DOOLA_WEBHOOK_SECRET=            # issued by doola over email, not self-served in the portal
# DOOLA_WEBHOOK_SECRET_PREVIOUS=   # only during a rotation window
DOOLA_ENVIRONMENT=sandbox
# ARC_NETWORK stays testnet here: mainnet + sandbox refuses to boot, by design.
ARC_NETWORK=testnet
# Synthetic, clearly-labeled identity data — no real names or addresses reach doola's dev env.
FORMATION_SANDBOX_SYNTHETIC_PII=true
# Faster sweeps make the E2E runbook workable; production leaves this at the 60s default.
# FORMATION_SWEEP_MS=15000
